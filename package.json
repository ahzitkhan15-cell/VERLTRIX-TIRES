{
  "name": "verltrix-tires-inventory",
  "version": "0.1.0",
  "private": true,
  "description": "VERLTRIX TIRES inventory management - React client and Node.js API",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace server run dev",
    "dev:web": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server start",
    "test": "npm --workspace server test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
